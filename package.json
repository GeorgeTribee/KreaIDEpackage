{
  "name": "krea-ide",
  "version": "1.2.8",
  "description": "AI-Powered React IDE directly from your terminal. Generate React + TailwindCSS + shadcn/ui components with AI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "krea": "./bin/krea.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts --format esm --watch",
    "start": "node bin/krea.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "ai",
    "ide",
    "terminal",
    "cli",
    "tailwindcss",
    "shadcn",
    "component-generator",
    "code-generation"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "inquirer": "^9.2.23",
    "openai": "^4.71.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/krea-ide"
  }
}